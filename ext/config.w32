	ADD_SOURCES(configure_module_dirname + "/gtk/gtk/searchentry", "gtksearchentry.zep.c", "gtk");
	ADD_SOURCES(configure_module_dirname + "/gtk/gtk/separator", "gtkseparator.zep.c", "gtk");
