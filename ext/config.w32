ARG_ENABLE("gtk", "enable gtk", "no");

if (PHP_GTK != "no") {
  EXTENSION("gtk", "gtk.c", null, "-I"+configure_module_dirname);
  ADD_SOURCES(configure_module_dirname + "/kernel", "main.c memory.c exception.c debug.c backtrace.c object.c array.c string.c fcall.c require.c file.c operators.c math.c concat.c variables.c filter.c iterator.c exit.c time.c", "gtk");
  /* PCRE is always included on WIN32 */
  AC_DEFINE("ZEPHIR_USE_PHP_PCRE", 1, "Whether PHP pcre extension is present at compile time");
  if (PHP_JSON != "no") {
    ADD_EXTENSION_DEP("gtk", "json");
    AC_DEFINE("ZEPHIR_USE_PHP_JSON", 1, "Whether PHP json extension is present at compile time");
  }
  
  ADD_SOURCES(configure_module_dirname + "/gtk/gtk/alertdialog", "gtkalertdialog.zep.c", "gtk");
	ADD_SOURCES(configure_module_dirname + "/gtk/gtk/application", "gtkapplication.zep.c", "gtk");
	ADD_SOURCES(configure_module_dirname + "/gtk/gtk/box", "gtkbox.zep.c", "gtk");
	ADD_SOURCES(configure_module_dirname + "/gtk/gtk/button", "gtkbutton.zep.c", "gtk");
	ADD_SOURCES(configure_module_dirname + "/gtk/gtk/centerbox", "gtkcenterbox.zep.c", "gtk");
	ADD_SOURCES(configure_module_dirname + "/gtk/gtk/checkbutton", "gtkcheckbutton.zep.c", "gtk");
	ADD_SOURCES(configure_module_dirname + "/gtk/gtk/colordialog", "gtkcolordialog.zep.c", "gtk");
	ADD_SOURCES(configure_module_dirname + "/gtk/gtk/dropdown", "gtkdropdown.zep.c", "gtk");
	ADD_SOURCES(configure_module_dirname + "/gtk/gtk/entry", "gtkentry.zep.c", "gtk");
	ADD_SOURCES(configure_module_dirname + "/gtk/gtk/filedialog", "gtkfiledialog.zep.c", "gtk");
	ADD_SOURCES(configure_module_dirname + "/gtk/gtk/fontdialog", "gtkfontdialog.zep.c", "gtk");
	ADD_SOURCES(configure_module_dirname + "/gtk/gtk/glarea", "gtkglarea.zep.c", "gtk");
	ADD_SOURCES(configure_module_dirname + "/gtk/gtk/gpupane", "gtkgpupane.zep.c", "gtk");
	ADD_SOURCES(configure_module_dirname + "/gtk/gtk/grid", "gtkgrid.zep.c", "gtk");
	ADD_SOURCES(configure_module_dirname + "/gtk/gtk", "gtk.zep.c gtkerror.zep.c gtkglib.zep.c", "gtk");
	ADD_SOURCES(configure_module_dirname + "/gtk/gtk/gtkswitch", "gtkswitch.zep.c", "gtk");
	ADD_SOURCES(configure_module_dirname + "/gtk/gtk/headerbar", "gtkheaderbar.zep.c", "gtk");
	ADD_SOURCES(configure_module_dirname + "/gtk/gtk/image", "gtkimage.zep.c", "gtk");
	ADD_SOURCES(configure_module_dirname + "/gtk/gtk/label", "gtklabel.zep.c", "gtk");
	ADD_SOURCES(configure_module_dirname + "/gtk/gtk/listbox", "gtklistbox.zep.c", "gtk");
	ADD_SOURCES(configure_module_dirname + "/gtk/gtk/listitem", "gtklistitem.zep.c", "gtk");
	ADD_SOURCES(configure_module_dirname + "/gtk/gtk/listview", "gtklistview.zep.c", "gtk");
	ADD_SOURCES(configure_module_dirname + "/gtk/gtk/menubutton", "gtkmenubutton.zep.c", "gtk");
	ADD_SOURCES(configure_module_dirname + "/gtk/gtk/notebook", "gtknotebook.zep.c", "gtk");
	ADD_SOURCES(configure_module_dirname + "/gtk/gtk/overlay", "gtkoverlay.zep.c", "gtk");
	ADD_SOURCES(configure_module_dirname + "/gtk/gtk/paned", "gtkpaned.zep.c", "gtk");
