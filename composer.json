{
    "name": "php-io-extensions/gtk",
    "type": "php-ext",
    "description": "GTK4 bound 1:1 into PHP (Zephir extension, Linux only)",
    "license": "MIT",
    "version": "0.8.0",
    "authors": [
        {
            "name": "Project Saturn Studios, LLC",
            "email": "info@projectsaturnstudios.com"
        }
    ],
    "require": {
        "php": ">=8.4"
    },
    "php-ext": {
        "extension-name": "gtk",
        "priority": 30,
        "build-path": "ext",
        "support-zts": true,
        "support-nts": true,
        "os-families": ["linux"],
        "configure-options": [
            {
                "name": "enable-gtk",
                "description": "Enable the gtk extension (Linux only)",
                "needs-value": false
            }
        ]
    }
}
