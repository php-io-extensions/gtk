{
    "name": "php-io-extensions/gtk",
    "type": "php-ext",
    "description": "1:1 PHP bindings of GTK 4 and the GLib main loop it runs on, as functions and classes named after their C counterparts",
    "keywords": [
        "gtk",
        "gtk4",
        "glib",
        "linux",
        "gui",
        "main-loop",
        "php-ext"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Project Saturn Studios, LLC",
            "email": "info@projectsaturnstudios.com"
        }
    ],
    "require": {
        "php": ">=8.4"
    },
    "require-dev": {
        "pestphp/pest": "^4.0"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.10.x-dev"
        }
    },
    "php-ext": {
        "extension-name": "gtk",
        "priority": 30,
        "support-zts": true,
        "support-nts": true,
        "os-families": [
            "linux",
            "darwin"
        ],
        "configure-options": [
            {
                "name": "enable-gtk",
                "description": "Enable the gtk extension",
                "needs-value": false
            }
        ]
    }
}
