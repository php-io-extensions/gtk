<?xml version="1.0"?>
<repository version="1.2"
            xmlns="http://www.gtk.org/introspection/core/1.0"
            xmlns:c="http://www.gtk.org/introspection/c/1.0"
            xmlns:glib="http://www.gtk.org/introspection/glib/1.0">
  <namespace name="Gdk" version="4.0">
    <function name="dial_up" c:identifier="gdk_dial_up"/>
    <function name="dial_down" c:identifier="gdk_dial_down"/>
    <function name="dial_reset" c:identifier="gdk_dial_reset"/>
    <function name="unrelated" c:identifier="gdk_unrelated"/>
  </namespace>
</repository>
